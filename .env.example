# Copy to .env and fill in the blanks.

# Server / SSH
AI_SERVER_HOST=
AI_SERVER_GATEWAY=
AI_SERVER_IFACE=
AI_SERVER_USER=
AI_SERVER_PASSWORD=

# OpenAI-compatible API (OVMS)
AI_API_PORT=8000
AI_API_URL=http://${AI_SERVER_HOST}:${AI_API_PORT}/v3
AI_API_KEY=

# llama.cpp llama-server (for OVMS vs llama.cpp comparisons)
LLAMA_API_PORT=8001
LLAMA_API_URL=http://${AI_SERVER_HOST}:${LLAMA_API_PORT}/v1

# Speed test (scripts/speed-test)
SPEED_TEST_MODEL=
SPEED_TEST_ITERATIONS=3
SPEED_TEST_MAX_TOKENS=256
SPEED_TEST_TEMPERATURE=0.7
SPEED_TEST_TIMEOUT_MS=120000
SPEED_TEST_PROMPT="Write a concise paragraph (about 120 words) explaining the benefits of running large language models locally on an Intel Arc GPU with OpenVINO."
