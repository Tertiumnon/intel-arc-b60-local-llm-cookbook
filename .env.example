# Copy to .env and fill in the blanks.

# Server / SSH
AI_SERVER_HOST=
AI_SERVER_GATEWAY=
AI_SERVER_IFACE=
AI_SERVER_USER=
AI_SSH_HOST=ai-b60

# Current Intel SYCL llama.cpp API.
AI_API_PORT=8001
AI_API_URL=http://${AI_SERVER_HOST}:${AI_API_PORT}/v1
AI_API_KEY=local
AI_MODEL_ID=

# Target for `bun run model` (Hugging Face GGUF repository and filename).
HF_MODEL_REPO=
HF_MODEL_FILE=
MODEL_CONTEXT_TOKENS=16384
MODEL_MTP=0
HF_MMPROJ_REPO=
HF_MMPROJ_FILE=
VSCODE_MODELS_FILE=

# Speed test (scripts/model--test-speed)
SPEED_TEST_MODEL=
SPEED_TEST_ITERATIONS=3
SPEED_TEST_MAX_TOKENS=256
SPEED_TEST_TEMPERATURE=0.7
SPEED_TEST_TIMEOUT_MS=120000
SPEED_TEST_PROMPT="Write a concise JavaScript function that sorts unique numbers."
