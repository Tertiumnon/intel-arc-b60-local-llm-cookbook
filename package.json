{
  "name": "intel-arc-b60-local-llm-cookbook",
  "version": "1.0.0",
  "private": true,
  "description": "Intel Arc B60 model setup and speed checks.",
  "type": "module",
  "scripts": {
    "switch": "bun scripts/model--switch/model--switch.ts",
    "switch:list": "bun scripts/model--switch/model--switch.ts --list-presets",
    "switch:coding": "bun scripts/model--switch/model--switch.coding.ts",
    "switch:tts": "bun run switch --preset=tts-qwen3",
    "image": "bun scripts/image--generate/image--generate.ts",
    "image:test": "bun scripts/image--test/image--test.ts",
    "3d:download": "bun scripts/image--download/image--download.ts hunyuan3d-2.1",
    "3d:download:trellis2": "bun scripts/image--download/image--download.ts trellis-2",
    "3d:start": "bun scripts/image--start/image--start.ts comfyui3d",
    "tts": "bun scripts/tts--speak/tts--speak.ts",
    "image:start": "bun scripts/image--start/image--start.ts comfyui",
    "image:download:qwen": "bun scripts/image--download/image--download.ts qwen-image-2.1-turbo",
    "image:download:z-image": "bun scripts/image--download/image--download.ts z-image-turbo",
    "pi": "bun scripts/pi--setup/pi--setup.ts",
    "delete": "bun scripts/model--delete/model--delete.ts",
    "quality": "bun scripts/model--quality/model--quality.ts",
    "test": "bun scripts/model--test/model--test.ts",
    "list": "bun scripts/model--test/model--test.ts --list",
    "typecheck": "tsc --noEmit",
    "changelog": "npx @tertium/gith changelog",
    "release:patch": "npx @tertium/gith release --patch",
    "release:minor": "npx @tertium/gith release --minor",
    "release:major": "npx @tertium/gith release --major",
    "test:quality:ctx49k:complex:all-models": "bun scripts/model--quality/model--quality.compare.ts --allocation=49152",
    "test:quality:ctx57k:complex:all-models": "bun scripts/model--quality/model--quality.compare.ts --allocation=57344",
    "test:quality:ctx64k:complex:all-models": "bun scripts/model--quality/model--quality.compare.ts --allocation=65536"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "typescript": "^5"
  }
}
