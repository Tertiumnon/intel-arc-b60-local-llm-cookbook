{
  "name": "intel-arc-b60-local-llm-cookbook",
  "version": "1.0.0",
  "private": true,
  "description": "Intel Arc B60 model setup and speed checks.",
  "type": "module",
  "scripts": {
    "switch": "bun scripts/model--switch/model--switch.ts",
    "switch:list": "bun scripts/model--switch/model--switch.ts --list-presets",
    "switch:strata": "bun run switch --service=strata --model=coder:IQ1_M",
    "switch:terse": "bun run switch --preset=terse",
    "switch:terse:ctx57k": "bun run switch --preset=terse:ctx57k",
    "switch:terse:ctx32k": "bun run switch --preset=terse:ctx32k",
    "switch:terse:no-mtp": "bun run switch --preset=terse:no-mtp",
    "switch:qwen36-27b-mtp": "bun run switch --preset=qwen36-27b-mtp",
    "switch:qwen36-27b-mtp:ctx57k": "bun run switch --preset=qwen36-27b-mtp:ctx57k",
    "switch:qwen36-27b-mtp:ctx32k": "bun run switch --preset=qwen36-27b-mtp:ctx32k",
    "switch:qwen36-27b-mtp:no-mtp": "bun run switch --preset=qwen36-27b-mtp:no-mtp",
    "switch:qwen38-27b-iq3m": "bun run switch --preset=qwen38-27b-iq3m",
    "switch:qwen38-27b-iq3m:ctx64k": "bun run switch --preset=qwen38-27b-iq3m:ctx64k",
    "switch:qwen38-27b-iq3m:ctx32k": "bun run switch --preset=qwen38-27b-iq3m:ctx32k",
    "switch:qwen38-27b-iq3m:no-mtp": "bun run switch --preset=qwen38-27b-iq3m:no-mtp",
    "switch:qwen38-27b-unsloth": "bun run switch --preset=qwen38-27b-unsloth",
    "switch:qwen38-27b-unsloth:ctx49k": "bun run switch --preset=qwen38-27b-unsloth:ctx49k",
    "switch:qwen38-27b-unsloth:ctx32k": "bun run switch --preset=qwen38-27b-unsloth:ctx32k",
    "switch:swift-1.5": "bun run switch --preset=swift-1.5",
    "switch:swift-1.5:ctx49k": "bun run switch --preset=swift-1.5:ctx49k",
    "switch:swift-1.5:ctx32k": "bun run switch --preset=swift-1.5:ctx32k",
    "switch:dirk": "bun run switch --preset=dirk",
    "switch:dirk:ctx32k": "bun run switch --preset=dirk:ctx32k",
    "switch:qwen38-pi": "bun run switch --preset=qwen38-pi",
    "switch:qwen38-pi:ctx32k": "bun run switch --preset=qwen38-pi:ctx32k",
    "switch:thinkingcap": "bun run switch --preset=thinkingcap",
    "switch:thinkingcap:ctx32k": "bun run switch --preset=thinkingcap:ctx32k",
    "delete": "bun scripts/model--delete/model--delete.ts",
    "quality": "bun scripts/model--quality/model--quality.ts",
    "test": "bun scripts/model--test/model--test.ts",
    "list": "bun scripts/model--test/model--test.ts --list",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "typescript": "^5"
  }
}
